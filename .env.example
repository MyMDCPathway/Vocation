# Google Gemini API key — required for all AI-powered features
# (career suggestions, pathway generation, career assessment, and exam info).
# Get a free key at https://aistudio.google.com/app/apikey
#
# Copy this file to `.env.local` and replace the value below with your key:
#   cp .env.example .env.local
GEMINI_API_KEY=your_key_here

# Optional. Which Gemini model to generate with. Defaults to
# "gemini-flash-latest", which follows the current Flash model so the app keeps
# working when a specific version is retired. Pin a version (for example
# "gemini-3.6-flash") if you need reproducible output.
# GEMINI_MODEL=gemini-flash-latest

# Optional but strongly recommended in production. Registration key for the US
# Bureau of Labor Statistics API, which supplies the real wage and employment
# figures on the career overview.
#
# The app works without it: unregistered callers get 25 requests a day per IP,
# which is fine locally against a warm cache. Past that, BLS refuses and the
# overview falls back to model estimates — clearly labelled as estimates, but
# still a downgrade. A key raises the limit to 500 requests of 50 series each
# and takes about a minute to get, free, at:
#   https://data.bls.gov/registrationEngine/
# BLS_API_KEY=your_key_here

# Optional but strongly recommended for scripts/fetch-scorecard.mjs. Registration
# key for the US Dept. of Education College Scorecard API, which supplies the
# admission rate, completion rate, median earnings, and net price figures
# /schools sorts by.
#
# Without it, fetch-scorecard falls back to api.data.gov's shared DEMO_KEY,
# whose rate limit only supports a handful of requests — enough to prove the
# script works against one small state, not a real national pull. A key is
# free and instant, no approval wait, at:
#   https://api.data.gov/signup/
# SCORECARD_API_KEY=your_key_here

# Optional, local only. Set to 1 to bypass rate limiting while running
# `npm run seed`, which deliberately makes many generations in a row.
# Never set this on a deployed server.
# SEED_MODE=1

# Required for accounts (login/signup). A Postgres connection string —
# Vercel Postgres or Neon both work; Prisma just needs standard postgresql://.
# Run `npx prisma migrate dev` once this is set to create the tables.
DATABASE_URL=postgresql://user:password@host:5432/database

# Required for accounts. Signs session cookies. Generate one with:
#   npx auth secret
# or: openssl rand -base64 32
#
# REMINDER — this value only lives in your local .env.local. Before deploying
# to Vercel, set it there too (`vercel env add AUTH_SECRET`, or the dashboard's
# Environment Variables tab) — without it, login 500s on production the same
# way it did locally before this was set.
AUTH_SECRET=

# Optional locally, REQUIRED in production. API key for Resend, which delivers
# the password reset email — the only mail this app sends.
#
# Without it the reset flow still works end to end: /api/auth/forgot-password
# creates a real token and app/lib/email.ts prints the reset link to the server
# console instead of mailing it, so you can copy it out of `npm run dev`'s
# output. Same "optional infrastructure degrades to a no-op" rule the durable
# cache follows — a missing key must never turn a student's request into a 500.
#
# Deployed, that fallback means a forgotten password is unrecoverable and the
# link lands in your logs, so set this before launch. Free key at:
#   https://resend.com/api-keys
# RESEND_API_KEY=re_your_key_here

# Required alongside RESEND_API_KEY — both must be set before any mail is
# actually sent, because a key with no verified sender is a request Resend
# rejects, which fails silently rather than loudly. Use an address at a domain
# you've verified in Resend:
#   EMAIL_FROM=Vocation <no-reply@yourdomain.com>
# EMAIL_FROM=

# Optional, and only used to build the link inside the reset email. Set it to
# this deployment's public origin (no trailing slash), e.g.
# https://vocation.example.com.
#
# Without it the link is built from the request's own origin, which comes from
# the Host header — a header a caller controls on any host that doesn't rewrite
# it, so a poisoned one would mail a valid reset token to an attacker's domain.
# Local dev and preview deployments are fine on the fallback; production should
# not be.
# APP_URL=

# ---------------------------------------------------------------------------
# Durable cache / rate limiting (Upstash Redis, via the Vercel integration)
# ---------------------------------------------------------------------------
#
# Set together or not at all. Without them durableCache.ts is a no-op and the
# app still works — but the daily Gemini ceiling silently stops being global
# and becomes 300 *per serverless instance*, which is the bug it was written to
# fix. Nothing warns when this happens, so if generation costs look wrong,
# check these first.
#
# The Vercel Upstash integration sets both automatically; `vercel env pull`
# brings them down for local use.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---------------------------------------------------------------------------
# Error reporting (Sentry) — optional
# ---------------------------------------------------------------------------
#
# All of this is optional. With no DSN the SDK never initialises, the webpack
# plugin never runs, and the app behaves exactly as it did before Sentry was
# added — which is the intended experience for a local clone.
#
# The DSN is a write-only ingest endpoint, not a secret; it ships in the client
# bundle by necessity. NEXT_PUBLIC_ is the one that matters — the server falls
# back to it if SENTRY_DSN isn't set separately.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=

# Only needed to upload source maps at build time, so stack traces are
# readable instead of minified. Without it the build still succeeds and the
# upload is skipped. This one IS a secret — never commit it.
# SENTRY_AUTH_TOKEN=

# Used by the build plugin to associate releases with the right Sentry
# project. Find them in your Sentry project's settings URL.
# SENTRY_ORG=
# SENTRY_PROJECT=
