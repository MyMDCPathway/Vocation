# Google Gemini API key — required for all AI-powered features
# (career suggestions, pathway generation, career assessment, and exam info).
# Get a free key at https://aistudio.google.com/app/apikey
#
# Copy this file to `.env.local` and replace the value below with your key:
#   cp .env.example .env.local
GEMINI_API_KEY=your_key_here

# Optional. Which Gemini model to generate with. Defaults to
# "gemini-flash-latest", which follows the current Flash model so the app keeps
# working when a specific version is retired. Pin a version (for example
# "gemini-3.6-flash") if you need reproducible output.
# GEMINI_MODEL=gemini-flash-latest

# Optional but strongly recommended in production. Registration key for the US
# Bureau of Labor Statistics API, which supplies the real wage and employment
# figures on the career overview.
#
# The app works without it: unregistered callers get 25 requests a day per IP,
# which is fine locally against a warm cache. Past that, BLS refuses and the
# overview falls back to model estimates — clearly labelled as estimates, but
# still a downgrade. A key raises the limit to 500 requests of 50 series each
# and takes about a minute to get, free, at:
#   https://data.bls.gov/registrationEngine/
# BLS_API_KEY=your_key_here

# Optional but strongly recommended for scripts/fetch-scorecard.mjs. Registration
# key for the US Dept. of Education College Scorecard API, which supplies the
# admission rate, completion rate, median earnings, and net price figures
# /schools sorts by.
#
# Without it, fetch-scorecard falls back to api.data.gov's shared DEMO_KEY,
# whose rate limit only supports a handful of requests — enough to prove the
# script works against one small state, not a real national pull. A key is
# free and instant, no approval wait, at:
#   https://api.data.gov/signup/
# SCORECARD_API_KEY=your_key_here

# Optional, local only. Set to 1 to bypass rate limiting while running
# `npm run seed`, which deliberately makes many generations in a row.
# Never set this on a deployed server.
# SEED_MODE=1

# Required for accounts (login/signup). A Postgres connection string —
# Vercel Postgres or Neon both work; Prisma just needs standard postgresql://.
# Run `npx prisma migrate dev` once this is set to create the tables.
DATABASE_URL=postgresql://user:password@host:5432/database

# Required for accounts. Signs session cookies. Generate one with:
#   npx auth secret
# or: openssl rand -base64 32
#
# REMINDER — this value only lives in your local .env.local. Before deploying
# to Vercel, set it there too (`vercel env add AUTH_SECRET`, or the dashboard's
# Environment Variables tab) — without it, login 500s on production the same
# way it did locally before this was set.
AUTH_SECRET=
